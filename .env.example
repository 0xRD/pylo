# Database
# Postgres is the supported runtime database. docker compose starts it automatically.
POSTGRES_DB=pylo
POSTGRES_USER=pylo
POSTGRES_PASSWORD=change_this_password
DATABASE_URL=postgresql+psycopg://pylo:change_this_password@postgres:5432/pylo

# Security — CHANGE THESE before first run (setup.sh generates them automatically)
PYLO_ENV=production
PYLO_ALLOW_INSECURE_DEFAULTS=false
PYLO_ALLOW_DEPRECATED_SQLITE=false
SECRET_KEY=replace_with_64_hex_chars
API_TOKEN=replace_with_random_urlsafe_token

PYLO_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PYLO_EXPOSE_DOCS=false
PYLO_ALLOW_PRIVATE_FETCH=false
PYLO_COOKIE_SECURE=false

# Session duration for JWT (hours)
JWT_EXPIRE_HOURS=24

# Docker runner
DOCKER_NETWORK=pylo_pylo_default
PYLO_BASE_IMAGE=pylo-runner-base:latest
PYLO_TIMEOUT_SECONDS=300
PYLO_MAX_CONCURRENT_RUNS=5
PYLO_MEM_LIMIT=256m
PYLO_CPU_QUOTA=50000
PYLO_RUN_TOKEN_TTL_SECONDS=900
# Host-side path for DooD volume mounts — auto-detected at startup from Docker mount info.
# Only needed as a fallback if auto-detection fails (e.g. rootless Docker).
# Set to the absolute path of pybooks_storage on the Docker host.
PYBOOKS_HOST_PATH=/opt/pylo/pybooks_storage

# MCP server (optional)
MCP_ENABLED=false
MCP_AUTH_TOKEN=change_me
